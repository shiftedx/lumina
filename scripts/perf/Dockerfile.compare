# Controlled benchmark runtime: the pinned Lumina backend/frontend and production
# jellyfin-ffmpeg, without the unused llama.cpp and speech-model payloads.  Build
# from a detached source worktree at the recorded commit.
FROM node:22.17.1-bookworm-slim@sha256:2fa754a9ba4d7adbd2a51d182eaabbe355c82b673624035a38c0d42b08724854 AS frontend-build
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM scratch AS media-debs
ADD --checksum=sha256:f3af50c1fdd76197867b9cd812fe8a3a1c671829a3f626a0ddc58a8e48654740 https://github.com/jellyfin/jellyfin-ffmpeg/releases/download/v8.1.2-5/jellyfin-ffmpeg8_8.1.2-5-trixie_arm64.deb /debs/

FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
ARG LUMINA_SOURCE_REVISION
LABEL org.opencontainers.image.title="Lumina comparison runtime" \
      org.opencontainers.image.revision="$LUMINA_SOURCE_REVISION" \
      org.opencontainers.image.description="Performance-only image; omits unused on-device model runtimes"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    LUMINA_DATA_DIR=/data \
    LUMINA_HOST=0.0.0.0 \
    LUMINA_PORT=8765
WORKDIR /app
RUN --mount=type=bind,from=media-debs,source=/debs,target=/tmp/media-debs \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 /tmp/media-debs/*.deb \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg \
    && ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe
COPY backend/requirements.runtime.lock /tmp/requirements.runtime.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.runtime.lock
COPY backend/ /app/backend/
COPY --from=frontend-build /build/frontend/dist /app/frontend/dist
EXPOSE 8765
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8765", "--log-level", "warning"]
