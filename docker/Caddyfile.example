# No `log` directive on purpose: Jellyfin stream URLs carry ApiKey tokens. See docker/README.md "Jellyfin apps".
{$LUMINA_HOSTNAME} {
	encode zstd gzip
	reverse_proxy lumina:8765 {
		# Let the edge choose zstd/gzip after the backend sends identity.
		header_up Accept-Encoding identity
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
}
