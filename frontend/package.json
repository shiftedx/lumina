{
  "name": "lumina-frontend",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "social:render": "node scripts/render-social-cards.mjs",
    "email:render": "node scripts/render-email-art.mjs",
    "build": "tsc --noEmit && vite build && node scripts/licenses.mjs && node scripts/check-styles.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit --pretty false && tsc --noEmit --pretty false -p e2e"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "dashjs": "^5.2.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.1",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
